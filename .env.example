# ── Lumix Social Manager — variáveis de ambiente ──────────────────
# Copie para .env e preencha. NUNCA commite o .env real.

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# TikTok — app "Lumix Social Manager" (developers.tiktok.com)
# O redirect_uri DEVE bater EXATAMENTE com o cadastrado no portal TikTok.
# Callback tratado pela própria API (o URI do n8n permanece cadastrado, mas não é usado pelo SDK).
TIKTOK_CLIENT_KEY=coloque-o-client-key-aqui
TIKTOK_CLIENT_SECRET=coloque-o-client-secret-aqui
TIKTOK_REDIRECT_URI=https://api.lumixagencia.com/auth/tiktok/callback

# Redis (BullMQ + cache + rate-limit)
REDIS_URL=redis://localhost:6379

# Criptografia dos tokens OAuth em repouso (AES-256-GCM)
# Gere com: openssl rand -hex 32  (64 chars hex = 32 bytes)
ENCRYPTION_KEY=coloque-64-chars-hex-aqui

# Webhooks n8n (validação de assinatura)
N8N_WEBHOOK_SECRET=coloque-um-segredo-forte-aqui

# URLs públicas
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Portas (default local)
PORT=3001
HEALTH_PORT=3002

# ── Frontend (apps/web) — expostas ao browser ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tracking da landing (opcionais — sem valor, nada é carregado)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
